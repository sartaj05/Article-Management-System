DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PORT=8000
POSTGRES_DB=article_management
POSTGRES_USER=article_management
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com

# Set these to true and configure HSTS when served only through HTTPS.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
TRUST_PROXY_SSL=false
USE_X_FORWARDED_HOST=false
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
ENFORCE_PRODUCTION_SECURITY=false
SECURITY_CSP=default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
SECURITY_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=()
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_STORAGE_BACKEND=filesystem
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
BACKUP_ROOT=backups
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=30
BACKUP_COMMAND_TIMEOUT=300
METRICS_TOKEN=replace-with-a-monitoring-token
API_KEY_USAGE_LOGGING_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
REDIS_URL=redis://localhost:6379/0
CACHE_BACKEND=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=article-studio
DATABASE_CONN_MAX_AGE=60
SSO_CALLBACK_URL=http://localhost:8000/api/sso/google/callback/
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8000
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
PAYMENT_HTTP_TIMEOUT=10
PAYMENT_REMOTE_CANCELLATION_ENABLED=false
PROVIDER_MAX_ATTEMPTS=5
PROVIDER_RETRY_BASE_SECONDS=60
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
NEWSLETTER_PROVIDER_URL=
NEWSLETTER_PROVIDER_TOKEN=
SOCIAL_PROVIDER_URL=
SOCIAL_PROVIDER_TOKEN=
DISTRIBUTION_SITE_URL=http://localhost:8000
DISTRIBUTION_HTTP_TIMEOUT=10
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
